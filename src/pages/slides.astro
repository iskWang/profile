</div>

<script is:inline>
let current = 0;
const slides = document.querySelectorAll('.slide');
const total = slides.length;
const counter = document.getElementById('counter');
const progress = document.getElementById('progress');
const themeToggle = document.getElementById('themeToggle');

function showSlide(i) {
  slides.forEach(s => s.classList.remove('active'));
  slides[i].classList.add('active');
  counter.textContent = `${i + 1} / ${total}`;
  progress.style.width = `${((i + 1) / total) * 100}%`;
  history.replaceState(null, '', '#' + (i + 1));
}

function navigate(dir) {
  current = Math.max(0, Math.min(total - 1, current + dir));
  showSlide(current);
}

function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  themeToggle.textContent = theme === 'light' ? 'Dark' : 'Light';
  try { localStorage.setItem('slides-theme', theme); } catch(e) {}
}

function toggleTheme() {
  applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
}

// Restore saved preference
try {
  const saved = localStorage.getItem('slides-theme');
  if (saved === 'light' || saved === 'dark') applyTheme(saved);
  else applyTheme('dark');
} catch(e) { applyTheme('dark'); }

document.addEventListener('keydown', e => {
  if (['ArrowRight','ArrowDown',' '].includes(e.key)) { e.preventDefault(); navigate(1); }
  if (['ArrowLeft','ArrowUp'].includes(e.key))         { e.preventDefault(); navigate(-1); }
});

let tx = 0;
document.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
document.addEventListener('touchend', e => {
  const d = tx - e.changedTouches[0].clientX;
  if (Math.abs(d) > 50) navigate(d > 0 ? 1 : -1);
});

function slideFromHash() {
  const n = parseInt(location.hash.slice(1)) - 1;
  return Number.isFinite(n) && n >= 0 ? Math.min(n, total - 1) : 0;
}

window.addEventListener('hashchange', () => {
  current = slideFromHash();
  showSlide(current);
});

current = slideFromHash();
showSlide(current);
</script>
