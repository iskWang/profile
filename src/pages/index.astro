---
// Fallback for hosts that do not run src/worker.js (e.g. `astro preview`).
// Same rule as the worker: legacy ?lang= link, then the saved `lang` cookie, then English only when it is
// the browser's top preference, otherwise zh-tw.
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>選擇語言 — Choose a language</title>
    <script is:inline>
      (() => {
        const legacy = { zh: 'zh-tw', 'zh-tw': 'zh-tw', en: 'en' }[new URLSearchParams(location.search).get('lang')];
        const saved = legacy ?? document.cookie.split(';').map((part) => part.trim()).find((part) => part.startsWith('lang='))?.slice(5);
        const first = (navigator.languages?.[0] ?? navigator.language ?? '').toLowerCase();
        const browser = first === 'en' || first.startsWith('en-') ? 'en' : 'zh-tw';
        const target = saved === 'en' || saved === 'zh-tw' ? saved : browser;
        const rest = new URLSearchParams(location.search);
        rest.delete('lang');
        const query = rest.toString();
        location.replace(`/${target}${query ? `?${query}` : ''}${location.hash}`);
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/zh-tw" /></noscript>
  </head>
  <body>
    <main>
      <h1>選擇語言 — Choose a language</h1>
      <p><a href="/zh-tw" lang="zh-TW">繁體中文</a> · <a href="/en" lang="en">English</a></p>
      <noscript><p>正在前往繁體中文版。若沒有自動跳轉，請使用上方連結選擇語言。</p></noscript>
    </main>
  </body>
</html>
