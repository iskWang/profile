---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header';
import Footer from '../../../components/Footer';

const posts = (await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const topics = [...new Set(posts.flatMap((post) => post.data.topics))].sort();
---

<Layout lang="en">
  <title slot="head">Blog — Josh Wang</title>
  <meta slot="head" name="description" content="Josh Wang's blog about writing, tools, and continuous learning." />
  <link slot="head" rel="canonical" href="https://joshwang.dev/en/blog" />
  <link slot="head" rel="alternate" hreflang="zh-TW" href="https://joshwang.dev/zh-tw/blog" />
  <link slot="head" rel="alternate" hreflang="en" href="https://joshwang.dev/en/blog" />
  <link slot="head" rel="alternate" type="application/rss+xml" href="https://joshwang.dev/en/blog/rss.xml" />
  <Header lang="en" variant="page" langHref="/zh-tw/blog" />
  <main class="px-6 pb-20 pt-32">
    <div class="mx-auto max-w-5xl">
      <header class="mb-10 max-w-2xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-teal">Blog</p>
        <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Blog</h1>
        <p class="mt-4 text-lg text-ink-soft">Notes on writing, tools, and continuous learning.</p>
      </header>

      <nav class="mb-8 flex flex-wrap gap-2" aria-label="Filter posts by topic">
        <button type="button" class="topic-filter rounded-full border border-teal bg-teal px-4 py-2 text-sm font-semibold text-white" data-topic="all" aria-pressed="true">All</button>
        {topics.map((topic) => (
          <button type="button" class="topic-filter rounded-full border border-line px-4 py-2 text-sm text-ink-soft hover:border-teal hover:text-teal" data-topic={topic} aria-pressed="false">{topic}</button>
        ))}
      </nav>

      {posts.length > 0 ? (
        <div class="space-y-5" data-post-list>
          {posts.map((post) => {
            return (
              <article class="rounded-2xl border border-line bg-paper-deep/30 p-6 transition hover:border-teal md:p-8" data-post-card data-topics={post.data.topics.join(' ')}>
                <p class="text-sm text-ink-soft"><time datetime={post.data.date}>{post.data.date}</time></p>
                <h2 class="mt-2 text-2xl font-bold tracking-tight"><a class="hover:text-teal" href={`/en/blog/${post.id.replace(/\.(?:zh|en)$/, '')}`}>{post.data.title}</a></h2>
                <p class="mt-3 leading-7 text-ink-soft">{post.data.summary}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {post.data.topics.map((topic) => <span class="rounded-full bg-teal-soft px-3 py-1 text-xs font-medium text-teal">{topic}</span>)}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <p class="rounded-2xl border border-line p-8 text-ink-soft">No published posts yet.</p>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll('[data-topic]');
    const cards = document.querySelectorAll('[data-post-card]');
    const validTopics = new Set(Array.from(buttons, (button) => button.dataset.topic));

    const applyFilter = (topic) => {
      buttons.forEach((item) => {
        const active = item.dataset.topic === topic;
        item.setAttribute('aria-pressed', String(active));
        item.classList.toggle('bg-teal', active);
        item.classList.toggle('text-white', active);
        item.classList.toggle('border-teal', active);
        item.classList.toggle('text-ink-soft', !active);
      });
      cards.forEach((card) => {
        card.hidden = topic !== 'all' && !card.dataset.topics.split(' ').includes(topic);
      });
    };

    buttons.forEach((button) => button.addEventListener('click', () => {
      const topic = button.dataset.topic;
      applyFilter(topic);
      const hash = topic === 'all' ? '' : `#${topic}`;
      history.replaceState(null, '', `${location.pathname}${location.search}${hash}`);
    }));

    window.addEventListener('hashchange', () => {
      const topic = location.hash.slice(1);
      applyFilter(validTopics.has(topic) ? topic : 'all');
    });

    const initialTopic = location.hash.slice(1);
    applyFilter(validTopics.has(initialTopic) ? initialTopic : 'all');
  })();
</script>
