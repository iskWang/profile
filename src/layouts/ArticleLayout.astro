---
import { render, type CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { FormHeader } from '../components/form';
import { UI } from '../i18n/ui.js';
import { LOCALES, localePath, otherLang } from '../i18n/locales.js';
import { attachmentCodes, counterpartOf, getPublishedPosts, postSlug, postUrl, relatedPosts } from '../lib/blog.js';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const lang = post.data.lang;
const locale = LOCALES[lang].htmlLang;
const ui = UI[lang];
const labels = ui.article;
const slug = postSlug(post);
const path = postUrl(lang, slug);
const counterpart = await counterpartOf(post);
const langHref = counterpart ? postUrl(otherLang(lang), slug) : undefined;
const alternates = [
  { lang: locale, path },
  ...(counterpart ? [{ lang: LOCALES[otherLang(lang)].htmlLang, path: langHref }] : []),
];
const related = await relatedPosts(post);
const attachmentCode = attachmentCodes(await getPublishedPosts(lang)).get(post.id);
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
const formatDate = (date: string) => new Intl.DateTimeFormat(LOCALES[lang].dateLocale, {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(new Date(date));
---

<Layout lang={locale} title={`${post.data.title} — Josh Wang`} description={post.data.summary} path={path} alternates={alternates}>
  <Header lang={lang} variant="page" langHref={langHref} />
  <main class="desk">
    <div class="sheet sheet--article">
      <FormHeader title={`${labels.attachment} ${attachmentCode}`} docNoLabel={ui.form.docNoLabel} docNo={ui.form.docNo} />
      <article class="post-shell post-page" data-article data-copy={labels.copy} data-copied={labels.copied} data-copy-failed={labels.failed} data-table-label={labels.table} data-code-label={labels.code}>
        <a class="post-back-link" href={localePath(lang, 'blog')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h14" /></svg>
          {labels.back}
        </a>
        <header class="post-header">
          <h1>{post.data.title}</h1>
          <p class="post-summary">{post.data.summary}</p>
          <div class="post-meta" aria-label={labels.information}>
            <span>Josh Wang</span><span aria-hidden="true">·</span>
            <time datetime={post.data.date}>{labels.published} {formatDate(post.data.date)}</time>
            {post.data.updated && <><span aria-hidden="true">·</span><time datetime={post.data.updated}>{labels.updated} {formatDate(post.data.updated)}</time></>}
          </div>
          <ul class="post-topics" aria-label={labels.topics}>
            {post.data.topics.map(topic => <li><a href={`${localePath(lang, 'blog')}#${topic}`}>{topic}</a></li>)}
          </ul>
        </header>
        {(post.data.origin === 'adapted' || post.data.translation === 'machine-assisted') && (
          <aside class="post-notices" aria-label={labels.notes}>
            {post.data.origin === 'adapted' && post.data.source && <p><strong>{labels.adapted}</strong> <a href={post.data.source} rel="noopener noreferrer">{post.data.source_title ?? post.data.source}</a>{post.data.source_date && <> ({post.data.source_date})</>}</p>}
            {post.data.translation === 'machine-assisted' && <p>{labels.translation}</p>}
          </aside>
        )}
        {sections.length >= 3 && (
          <details class="post-toc">
            <summary>{labels.contents}</summary>
            <nav aria-label={labels.contents}>
              <ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
            </nav>
          </details>
        )}
        <div class="post-body post-reading-column"><Content /></div>
        {related.length > 0 && (
          <section class="post-related" aria-label={labels.related}>
            <h2 class="post-related-heading">{labels.related}</h2>
            <div class="post-related-grid">
              {related.map(item => (
                <a class="post-related-card" href={postUrl(lang, postSlug(item))}>
                  <p class="post-related-date"><time datetime={item.data.date}>{item.data.date}</time></p>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>

<script>
  const article = document.querySelector<HTMLElement>('[data-article]');
  if (article) {
    const labels = article.dataset;
    article.querySelectorAll<HTMLPreElement>('.post-body pre').forEach(pre => {
      const code = pre.querySelector('code');
      if (!code) return;
      const caption = pre.previousElementSibling;
      const hasCaption = caption?.classList.contains('code-caption');
      const name = (hasCaption ? caption.textContent : pre.dataset.language) || labels.codeLabel!;
      const block = document.createElement('div');
      block.className = 'post-code-block';
      const toolbar = document.createElement('div');
      toolbar.className = 'post-code-toolbar';
      const label = document.createElement('span');
      label.className = 'post-code-label';
      label.textContent = name;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'post-copy-button';
      button.innerHTML = `
        <svg class="post-copy-icon post-copy-icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="1.5"/><path d="M5.5 15V6a1.5 1.5 0 0 1 1.5-1.5h9"/></svg>
        <svg class="post-copy-icon post-copy-icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg>
        <span class="post-copy-label">${labels.copy}</span>
      `;
      button.setAttribute('aria-label', `${labels.copy}: ${name}`);
      const status = document.createElement('span');
      status.className = 'post-copy-status';
      status.setAttribute('role', 'status');
      pre.setAttribute('aria-label', name);
      pre.tabIndex = 0;
      toolbar.append(label, button, status);
      pre.before(block);
      block.append(toolbar, pre);
      if (hasCaption) caption.remove();
      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener('click', async () => {
        clearTimeout(resetTimer);
        status.textContent = '';
        status.classList.remove('is-copied', 'is-error');
        button.classList.remove('is-copied');
        button.disabled = true;
        let copied = false;
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          copied = true;
        } catch {
          // LAN HTTP previews lack Clipboard API; keep a user-initiated fallback.
          const selection = window.getSelection();
          const saved = selection && selection.rangeCount ? selection.getRangeAt(0).cloneRange() : null;
          const range = document.createRange();
          range.selectNodeContents(code);
          selection?.removeAllRanges();
          selection?.addRange(range);
          try { copied = document.execCommand('copy'); } catch { /* Report failure below. */ }
          if (copied) {
            selection?.removeAllRanges();
            if (saved) selection?.addRange(saved);
          }
        }
        status.textContent = copied ? labels.copied! : labels.copyFailed!;
        status.classList.add(copied ? 'is-copied' : 'is-error');
        if (copied) {
          button.classList.add('is-copied');
          resetTimer = setTimeout(() => button.classList.remove('is-copied'), 1800);
        }
        button.disabled = false;
      });
    });
    article.querySelectorAll<HTMLTableElement>('.post-body table').forEach(table => {
      const region = document.createElement('div');
      region.className = 'post-table-scroll';
      region.tabIndex = 0;
      region.setAttribute('role', 'region');
      region.setAttribute('aria-label', table.caption?.textContent || labels.tableLabel!);
      table.before(region);
      region.append(table);
    });
    const revealHash = () => {
      let id;
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target || !article.contains(target)) return;
      let opened = false;
      for (let parent = target.parentElement; parent; parent = parent.parentElement) {
        if (parent instanceof HTMLDetailsElement && !parent.open) {
          parent.open = true;
          opened = true;
        }
      }
      if (opened) target.scrollIntoView();
    };
    window.addEventListener('hashchange', revealHash);
    revealHash();
  }
</script>
